# Technical Design: Concert Detail Overlay

## 1. Component Architecture

### ConcertDetailSheet Component Structure

```tsx
interface ConcertDetailSheetProps {
  event: EventWithArtist & { source?: string; url?: string };
  onDismiss: () => void;
}

export default function ConcertDetailSheet({ event, onDismiss }: ConcertDetailSheetProps) {
  const snapPoints = ['25%', '90%']; // Initial snap at 25%, final at 90%
  
  return (
    <BottomSheetModal 
      snapPoints={snapPoints}
      handleIndicatorStyle={{ backgroundColor: 'rgba(255,255,255,0.3)' }}
      handleStyle={{ height: 5, borderRadius: 2.5 }}
      backdropBackgroundColor="rgba(0,0,0,0.5)"
      onClose={onDismiss}
    >
      <View style={styles.sheetContent}>
        {/* Header Component */}
        <ConcertDetailHeader 
          event={event} 
          onDismiss={onDismiss} 
          onOverflowPress={handleOverflowPress} 
        />
        
        {/* Content Layout */}
        <ScrollView contentContainerStyle={styles.contentContainer}>
          {/* Artist Photo */}
          <Image 
            source={{ uri: event.artist?.image_url || DEFAULT_IMAGE }}
            style={styles.artistPhoto}
            resizeMode="cover"
          />
          
          {/* Date Card */}
          <View style={styles.dateCard}>
            <Text style={styles.dateText}>
              {formatDate(event.date)}
            </Text>
            <Text style={styles.locationText}>
              {event.venue}, {event.city}
            </Text>
          </View>
          
          {/* Event Info */}
          <View style={styles.infoSection}>
            <Text style={styles.title}>{event.artist?.name}</Text>
            <Text style={styles.details}>
              {formatDateLong(event.date)} • {event.city}
            </Text>
          </View>
          
          {/* Action Button */}
          <TouchableOpacity 
            style={styles.actionButton}
            disabled={!event.url}
            onPress={handleUrlPress}
          >
            <Text style={styles.actionButtonText}>
              {event.url ? 'Ver Entradas' : 'Sin enlace'}
            </Text>
          </TouchableOpacity>
        </ScrollView>
      </View>
    </BottomSheetModal>
  );
}
```

### Props Interface
- `event`: Extended EventWithArtist type including optional `source` and `url` fields
- `onDismiss`: Callback to close the bottom sheet

### Integration with @gorhom/bottom-sheet
- Uses `BottomSheetModal` component with snap points at 25% (initial) and 90% (final)
- Custom handle indicator styling to match dark theme (white with 30% opacity)
- Backdrop with semi-transparent black background for modal effect
- `onClose` prop connected to dismiss handler

